{
  "name": "wizsite",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check site.js && node --check faq.js && for f in app/*.js app/pages/*.js scripts/app-check.mjs; do node --check \"$f\" || exit 1; done && python3 -B scripts/check.py",
    "test": "python3 -B -m unittest discover -s scripts -p 'test_*.py'",
    "test:functions": "node --test tests/sign-in.test.mjs tests/drivers.test.mjs tests/ask-index.test.mjs tests/ask.test.mjs",
    "test:app": "node scripts/app-check.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3"
  },
  "devDependencies": {
    "gsap": "3.15.1"
  }
}
