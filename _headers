# Cloudflare Pages. The build fingerprints styles and scripts (name.<hash>.ext), which is what keeps new HTML
# from meeting an old cached file. These rules also ask for revalidation; they take effect only if the
# zone's Browser Cache TTL is set to respect existing headers.
# The site CSP allows Cloudflare Web Analytics: Cloudflare injects its beacon script from
# static.cloudflareinsights.com into every HTML page, and the beacon reports to cloudflareinsights.com.
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com https://cloudflareinsights.com; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
# The pages that host Ask a Wiz (the landing and /faq) may load and frame Cloudflare Turnstile, and nothing more.
# Detach the site-wide CSP so Cloudflare Pages does not comma-join the two.
/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
/faq/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
# The app (openwiz.dev/app) reads only GitHub's API and this site (its sign-in helper): the browser refuses any
# other destination, inline script or style, framing, and sending a referrer. /app/* also covers /app/ itself.
# Detach the site-wide CSP and Referrer-Policy so Cloudflare Pages does not comma-join them with the app rules.
/app/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  ! Referrer-Policy
  Referrer-Policy: no-referrer
