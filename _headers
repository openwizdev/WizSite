# Cloudflare Pages. The build fingerprints styles and scripts (name.<hash>.ext), which is what keeps new HTML
# from meeting an old cached file. These rules also ask for revalidation; they take effect only if the
# zone's Browser Cache TTL is set to respect existing headers.
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
