# Cloudflare Pages. The build fingerprints styles and scripts (name.<hash>.ext), which is what keeps new HTML
# from meeting an old cached file. These rules also ask for revalidation; they take effect only if the
# zone's Browser Cache TTL is set to respect existing headers.
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
# The app (openwiz.dev/app) reads only GitHub's API and this site (its sign-in helper): the browser refuses any
# other destination, inline script or style, framing, and sending a referrer. /app/* also covers /app/ itself.
/app/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; connect-src 'self' https://api.github.com; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/book/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self'; media-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
