{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "read_at", "prs_merged_total", "prs_merged_7d", "drivers_verified", "agents_running"],
  "properties": {
    "schema": { "type": "string", "const": "openwiz.showcase.v1" },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "prs_merged_total": { "type": ["integer", "null"], "minimum": 0 },
    "prs_merged_7d": { "type": ["integer", "null"], "minimum": 0 },
    "drivers_verified": { "type": ["integer", "null"], "minimum": 0 },
    "agents_running": { "type": ["integer", "null"], "minimum": 0 }
  }
}
